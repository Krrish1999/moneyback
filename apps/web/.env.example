# Copy to .env.local (git-ignored). Neither value is a secret; both are visible in the browser.

# Address of the API. Leave empty to run the web app on its in-memory mock.
VITE_API_URL=http://localhost:8787

# Google OAuth web client id. Must be the same as GOOGLE_CLIENT_ID in apps/api/wrangler.jsonc.
VITE_GOOGLE_CLIENT_ID=
